---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title="Contact"
  description="Contact James Moore, Ph.D. candidate in Biochemistry and Molecular Biology at the University of Nevada, Reno and Desert Research Institute."
>
  <div class="page-shell contact-page">
    <SectionIntro
      eyebrow="Contact"
      title="Let’s talk science."
      intro="For research, collaboration, or professional inquiries, please use my institutional email or connect through GitHub or LinkedIn."
    />
    <a class="contact-link-panel" href={`mailto:${profile.email}`}>
      <span class="contact-link-label">Professional email</span>
      <span class="contact-link-value">{profile.email}</span>
      <span class="contact-link-arrow" aria-hidden="true">↗</span>
    </a>
    <a class="contact-link-panel" href={profile.github} rel="me">
      <span class="contact-link-label">GitHub profile</span>
      <span class="contact-link-value">github.com/JamesMoore1998</span>
      <span class="contact-link-arrow" aria-hidden="true">↗</span>
    </a>
    <a class="contact-link-panel" href={profile.linkedin} rel="me">
      <span class="contact-link-label">LinkedIn profile</span>
      <span class="contact-link-value">linkedin.com/in/james-moore-6b5338333</span>
      <span class="contact-link-arrow" aria-hidden="true">↗</span>
    </a>
    <p class="contact-note">This independent portfolio is not an official University of Nevada, Reno or Murray Lab website.</p>
  </div>
</BaseLayout>
