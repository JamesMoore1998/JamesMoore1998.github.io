---
import { profile } from '../data/profile';
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>{profile.name} <span aria-hidden="true">·</span> {profile.institution}</p>
    <div class="footer-links">
      <a href={profile.github} rel="me">GitHub <span aria-hidden="true">↗</span></a>
      <a href={profile.linkedin} rel="me">LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</footer>
